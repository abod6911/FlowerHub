# ==============================================================================
# FLOWERHUB ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# SECURITY NOTICE:
# 1. NEVER commit your actual `.env` file to version control.
# 2. Variables prefixed with `VITE_` or `NEXT_PUBLIC_` are INCLUDED IN CLIENT BUNDLES.
# 3. Secret keys (Service Role, Database Passwords, Payment Keys) MUST NEVER be prefixed with `VITE_`.
# ==============================================================================

# --- CLIENT-SAFE CONFIGURATION (Exposed to Browser) ---
VITE_APP_ENV=production
VITE_SHOP_NAME="دار الورد للمناسبات"
VITE_DEFAULT_LOCALE=ar
# Public Anonymous Key for Supabase Client (Protected by RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- SERVER-SIDE ONLY SECRETS (NEVER EXPOSE TO CLIENT BUNDLE) ---
# Supabase Service Role Key (Bypasses RLS - Server API Routes ONLY)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Cryptographic Master Session Secret for Signing Tokens
SESSION_SECRET=your_32_byte_random_session_secret_here

# Payment Gateway Private Key (Mada / Apple Pay / HyperPay / Moyasar)
PAYMENT_GATEWAY_SECRET_KEY=sk_live_your_payment_secret_key_here

# WhatsApp Business Cloud API Token (Server Webhooks ONLY)
WHATSAPP_API_BEARER_TOKEN=your_whatsapp_server_token_here
